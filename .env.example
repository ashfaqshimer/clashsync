# ==============================================================================
# ClashSync Environment Variables Sample
# Copy this file to `.env.local` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Neon Serverless PostgreSQL)
# Get this from your Neon Console (Dashboard -> Connection Details).
# Use the pooled connection string (ep-...-pooler...) for serverless environments.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. App Base URL
# Local: http://localhost:3000 (or your ngrok URL when testing inbound webhooks)
# Production: https://your-clashsync-domain.vercel.app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Upstash QStash (Serverless Scheduling & Webhook Delivery)
# Get these from your Upstash Console (Upstash -> QStash -> Details / Keys).
# ------------------------------------------------------------------------------
# QSTASH_URL is your region's base URL as shown in the console (not a /publish URL).
# Signing keys are needed wherever /api/cron/notify runs (Vercel). The token is
# only used by `pnpm qstash:schedule`, which creates the alert schedule once.
QSTASH_URL="https://qstash-us-east-1.upstash.io"
QSTASH_TOKEN="ey..."
QSTASH_CURRENT_SIGNING_KEY="sig_..."
QSTASH_NEXT_SIGNING_KEY="sig_..."

# ------------------------------------------------------------------------------
# 4. Discord Integration
# Alerts currently use per-village webhooks that owners paste on their
# dashboard, so none of these are needed yet. The bot/OAuth values are for
# Discord login and DMs (Phase 7).
# Get these from the Discord Developer Portal (https://discord.com/developers/applications).
# ------------------------------------------------------------------------------
# Bot Token (Bot -> Token)
DISCORD_BOT_TOKEN="your-bot-token"

# OAuth / App Credentials (General Information -> Client ID & Client Secret)
DISCORD_CLIENT_ID="your-client-id"
DISCORD_CLIENT_SECRET="your-client-secret"

# Optional: Direct Channel Webhook URL (for quick testing/fallback channel alerts)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# ------------------------------------------------------------------------------
# 5. Official Clash of Clans Developer API (Optional)
# Get a key from https://developer.clashofclans.com to enable auto player tag lookup.
# ------------------------------------------------------------------------------
# Calls go through RoyaleAPI's proxy (cocproxy.royaleapi.dev), so when creating
# the key, whitelist the proxy's IP from docs.royaleapi.com, not your own.
# The same key works locally and on Vercel.
CLASH_API_KEY="your-supercell-developer-api-key"

# Local dev only: fake player profiles and accept any Verify token (except the
# literal "invalid"), with no key or network needed. Ignored in production.
# CLASH_API_MOCK="1"

# ------------------------------------------------------------------------------
# 6. App Auth / Secret (Optional / Future Auth Sessions)
# Generate a random 32-character string (e.g. `openssl rand -base64 32`)
# ------------------------------------------------------------------------------
AUTH_SECRET="your-random-32-character-secret"

